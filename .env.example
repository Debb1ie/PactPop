# ───────────────────────── PactPop configuration ─────────────────────────
# Copy to .env and fill in. Never commit .env. Never put these in NEXT_PUBLIC_* variables.

# Public base URL of the app (used for PayPal return URLs and links in invoices).
APP_URL=http://localhost:3000

# Database.
#   Leave empty  → embedded PGlite in ./.data/pglite (zero setup, local dev only)
#   postgres://… → real PostgreSQL (required for deployment). Add ?sslmode=require for managed hosts.
DATABASE_URL=

# PayPal REST app credentials — SANDBOX ONLY.
# developer.paypal.com → Apps & Credentials → Sandbox → Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be the sandbox host; the app refuses to start against live PayPal.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# ID of the webhook you register for <APP_URL>/api/paypal/webhook (used for signature verification).
PAYPAL_WEBHOOK_ID=

# AI provider for PactPop's runtime agents.
#   groq      → open models on Groq (free tier available; key from console.groq.com, starts with gsk_)
#   anthropic → Claude via the Anthropic API
#   heuristic → rule-based mode, clearly labelled in the UI (no AI calls)
AI_PROVIDER=groq
AI_API_KEY=
# Leave empty for the default: openai/gpt-oss-120b (groq) or claude-opus-5-5 (anthropic)
AI_MODEL=
